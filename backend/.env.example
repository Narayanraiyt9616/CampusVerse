# CampusVerse AI - Backend Environment Template (Part 2)
# Copy this file to .env and configure local values

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. Render production URL or local development)
FRONTEND_URL=https://campusverse-1-oi4y.onrender.com

# MongoDB Connection String (Atlas Replica Set or Local mongod)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusverse?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/campusverse
MONGODB_URI=

# Development Writes Permission (True in development until Part 3 authentication is activated)
ALLOW_DEV_WRITES=true

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1h

# Initial Administrator Seed Credentials (Used for bootstrap only)
ADMIN_USERNAME=narayanraiopen
ADMIN_EMAIL=admin@campusverse.edu
ADMIN_PASSWORD=your_secure_admin_password

# Initial Super Admin Seed Credentials (Restricted to superadmin role)
SUPERADMIN_EMAIL=superadmin@campusverse.edu
SUPERADMIN_PASSWORD=your_secure_superadmin_password
